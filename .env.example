# Copy to .env and adjust. Fresh-clone defaults below match a standard local Postgres install.
# Remote hosts (e.g. Supabase Session pooler) get SSL automatically — no extra config needed:
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lccb_academix
JWT_SECRET=change-me-dev
PORT=4000
DEVICE_API_KEY=dev-device-key

# Antigravity AI Assistant Configuration (Google Gemini API)
# GEMINI_API_KEY=AIzaSy...

# Demo mode is automatic in local development. On a production deployment,
# set BOTH flags to keep the role switcher and the shared demo password alive.
# VITE_DEMO_MODE is baked in at build time; DEMO_MODE is read by the API.
# DEMO_MODE=1
# VITE_DEMO_MODE=1
