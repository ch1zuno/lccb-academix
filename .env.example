# Copy to .env and adjust. Fresh-clone defaults below match a standard local Postgres install.
# Remote hosts (e.g. Supabase Session pooler) get SSL automatically — no extra config needed:
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lccb_academix
JWT_SECRET=change-me-dev
PORT=4000
DEVICE_API_KEY=dev-device-key

# Antigravity AI Assistant Configuration (Google Gemini API)
# GEMINI_API_KEY=AIzaSy...

# Centrifugo Realtime Server Configuration
# CENTRIFUGO_SECRET must be at least 32 characters long
CENTRIFUGO_SECRET=change-me-to-a-very-long-secret-key-at-least-32-chars
CENTRIFUGO_PROXY_SECRET=change-me-proxy-secret-key-at-least-32-chars
CENTRIFUGO_URL=http://localhost:8000

# Jitsi Meet Video Room Configuration
JITSI_ROOM_SECRET=change-me-to-a-secure-jitsi-room-secret
VITE_JITSI_DOMAIN=meet.jit.si

# Cloudflare R2 Object Storage (optional — falls back to PostgreSQL bytea when unset)
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# R2_BUCKET_NAME=lccb-academix
# R2_PUBLIC_URL=https://pub-your-bucket-id.r2.dev

# Supabase Client Configuration (for Google Sign-In with LCCB domain hd)
# VITE_SUPABASE_URL=https://wxxyeijueodxxqvwemjx.supabase.co
# VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google OAuth 2.0 Web Client ID (optional — Demo Chooser works when unset in DEMO_MODE=1)
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
ALLOWED_EMAIL_DOMAINS=lccbonline.edu.ph,lccbacolod.edu.ph

# Demo mode is automatic in local development. On a production deployment,
# set BOTH flags to keep the role switcher and the shared demo password alive.
# VITE_DEMO_MODE is baked in at build time; DEMO_MODE is read by the API.
# DEMO_MODE=1
# VITE_DEMO_MODE=1
